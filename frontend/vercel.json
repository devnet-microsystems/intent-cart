{
  "rewrites": [
    { "source": "/checkout/return", "destination": "/index.html" },
    { "source": "/checkout/cancel", "destination": "/index.html" },
    { "source": "/((?!api|_next|favicon.ico|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
